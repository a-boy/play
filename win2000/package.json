{
  "name": "win2000",
  "version": "1.0.0",
  "description": "Windows 2000 UI React component library with demo app",
  "type": "module",
  "private": true,
  "workspaces": ["packages/components", "packages/demo"],
  "scripts": {
    "dev": "npm run dev -w @win2000/demo",
    "build": "npm run build -w @win2000/components && npm run build -w @win2000/demo",
    "demo:dev": "npm run dev -w @win2000/demo",
    "components:build": "npm run build -w @win2000/components",
    "test": "npm run test -w @win2000/components",
    "test:watch": "npm run test:watch -w @win2000/components",
    "test:ui": "npm run test:ui -w @win2000/components"
  },
  "keywords": ["windows", "2000", "react", "ui", "components"],
  "author": "",
  "license": "ISC"
}
